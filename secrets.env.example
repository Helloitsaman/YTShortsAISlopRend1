# Example only. Save real keys in %LOCALAPPDATA%\ShortsStudio\secrets.env,
# or set SHORTS_SECRET_FILE to another private file outside this repository.
# Never commit real keys, and never put them in browser code or the media manifest.

ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Image-finder agent sources (keyless by default: Openverse + Wikimedia Commons).
# An Openverse access token is optional and only raises the anonymous rate limit:
OPENVERSE_ACCESS_TOKEN=your_openverse_access_token_here
